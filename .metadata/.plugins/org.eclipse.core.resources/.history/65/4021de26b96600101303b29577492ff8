<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <title>Admin - Skypers</title>
  <link rel="stylesheet"
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
</head>

<script>
  const role = sessionStorage.getItem('role');
  if (!role || (role !== 'admin')) {
    window.location.href = '/login';
  }
</script>

<body class="bg-light">
  <div class="container-fluid">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <a class="navbar-brand" href="#">Skypers Admin</a>
      <div class="navbar-nav">
        <a class="nav-link" th:href="@{/admin/productos}">Productos</a>
        <a class="nav-link" th:href="@{/admin/ventas}">Ventas</a>
      </div>
    </nav>

    <div th:switch="${page}">
      <div th:case="'productos'" th:replace="fragments/productos-list :: listaProductos"></div>
      <div th:case="'ventas'" th:replace="fragments/ventas-list :: listaVentas"></div>
    </div>
  </div>
</body>
</html>
